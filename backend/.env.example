# WattWise Backend Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Local Offline-First Database: SQLite (WAL Mode)
# Runs natively with zero setup and sub-millisecond latency.
SQLITE_DB_PATH=data/wattwise.db

# Online Cloud Database: Supabase PostgreSQL
# Provide your Supabase project URL and anon/service key to enable cloud synchronization.
# If omitted or offline, the app operates 100% offline via SQLite and queues records.
SUPABASE_URL=
SUPABASE_KEY=
AUTO_CLOUD_SYNC=True

# Optional AI LLM Integration (Gemini)
GEMINI_API_KEY=

